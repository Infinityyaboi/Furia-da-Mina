{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Raylib Game",
            "command": "gcc",
            "args": [
                "main.c",
                "items.c",
                "-o",
                "main.exe",
                "-I",
                "C:/raylib/raylib/src",
                "-L",
                "C:/raylib/raylib/src",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles Furia-da-Mina using gcc"
        }
    ]
}
